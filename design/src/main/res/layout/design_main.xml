<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <data>
        <variable
            name="self"
            type="com.github.kr328.clash.design.MainDesign" />
        <variable
            name="clashRunning"
            type="boolean" />
        <variable
            name="hasProfiles"
            type="boolean" />
        <variable
            name="mode"
            type="String" />
        <variable
            name="profileName"
            type="String" />
        <variable
            name="hasProviders"
            type="boolean" />
        <variable
            name="colorClashStarted"
            type="int" />
        <variable
            name="colorClashStopped"
            type="int" />
        <variable
            name="profileTrafficUsed"
            type="String" />
        <variable
            name="profileTrafficTotal"
            type="String" />
        <variable
            name="profileExpire"
            type="String" />
        <variable
            name="profileUpdated"
            type="String" />
        <variable
            name="hasTrafficInfo"
            type="boolean" />
        <variable
            name="hasExpireInfo"
            type="boolean" />
        <variable
            name="profileSupportUrl"
            type="String" />
        <variable
            name="profileWebPageUrl"
            type="String" />
        <variable
            name="profileAnnounce"
            type="String" />
        <variable
            name="profileLogoUrl"
            type="String" />
        <variable
            name="profileTitleOverride"
            type="String" />

        <import type="android.view.View" />
        <import type="android.text.TextUtils" />
        <import type="com.github.kr328.clash.design.MainDesign.Request" />
    </data>

    <androidx.coordinatorlayout.widget.CoordinatorLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingStart="@{self.surface.insets.start}"
        android:paddingEnd="@{self.surface.insets.end}">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <ScrollView
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:scrollbars="none"
                android:fillViewport="true">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:clipToPadding="false"
                    android:orientation="vertical"
                    android:paddingHorizontal="@dimen/main_padding_horizontal"
                    android:paddingTop="@{self.surface.insets.top}"
                    android:paddingBottom="16dp">

                    <!-- ========== HEADER: Logo + App Name (always visible) ========== -->
                    <LinearLayout
                        android:id="@+id/header_layout"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:minHeight="@dimen/main_top_banner_height"
                        android:orientation="horizontal">

                        <FrameLayout
                            android:layout_width="@dimen/large_item_header_layout_size"
                            android:layout_height="@dimen/large_item_header_layout_size">

                            <ImageView
                                android:id="@+id/app_logo"
                                android:layout_width="@dimen/main_logo_size"
                                android:layout_height="@dimen/main_logo_size"
                                android:layout_gravity="center"
                                android:src="@drawable/ic_clash"
                                android:scaleType="fitCenter" />
                        </FrameLayout>

                        <TextView
                            android:id="@+id/app_title"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/application_name"
                            android:textAppearance="@style/TextAppearance.Material3.HeadlineSmall" />
                    </LinearLayout>

                    <!-- ========== ONBOARDING STATE (no profiles) ========== -->
                    <LinearLayout
                        android:id="@+id/onboarding_layout"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:visibility="@{!hasProfiles &amp;&amp; !clashRunning ? View.VISIBLE : View.GONE}">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="48dp"
                            android:text="@string/welcome"
                            android:textAppearance="@style/TextAppearance.Material3.HeadlineLarge"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:alpha="0.7"
                            android:text="@string/add_first_profile"
                            android:textAppearance="@style/TextAppearance.Material3.BodyLarge" />

                        <FrameLayout
                            android:layout_width="120dp"
                            android:layout_height="120dp"
                            android:layout_marginTop="48dp"
                            android:background="@drawable/bg_power_button"
                            android:clickable="true"
                            android:focusable="true"
                            android:foreground="@drawable/bg_power_button_ripple"
                            android:onClick="@{() -> self.showAddProfileSheet()}">

                            <ImageView
                                android:layout_width="48dp"
                                android:layout_height="48dp"
                                android:layout_gravity="center"
                                android:src="@drawable/ic_baseline_add"
                                android:contentDescription="@string/add_profile"
                                app:tint="@android:color/white" />
                        </FrameLayout>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="16dp"
                            android:alpha="0.7"
                            android:text="@string/add_profile"
                            android:textAppearance="@style/TextAppearance.Material3.BodyMedium" />
                    </LinearLayout>

                    <!-- ========== PROFILE CARD (visible when has profiles, both connected and disconnected) ========== -->
                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/profile_card"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:clickable="true"
                        android:focusable="true"
                        android:foreground="@drawable/bg_card_focus_ripple"
                        android:visibility="@{hasProfiles ? View.VISIBLE : View.GONE}"
                        app:cardBackgroundColor="?attr/colorSurfaceVariant"
                        app:cardCornerRadius="16dp"
                        app:cardElevation="0dp"
                        app:strokeColor="@color/card_stroke_focus"
                        app:strokeWidth="2dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="16dp">

                            <!-- Profile header row: sync + name + manage on right -->
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:gravity="center_vertical"
                                android:orientation="horizontal">

                                <ImageView
                                    android:layout_width="24dp"
                                    android:layout_height="24dp"
                                    android:background="@drawable/bg_toolbar_button_focus"
                                    android:clickable="true"
                                    android:focusable="true"
                                    android:onClick="@{() -> self.request(Request.UpdateProfile)}"
                                    android:src="@drawable/ic_baseline_sync"
                                    android:contentDescription="@string/update"
                                    app:tint="?attr/colorOnSurfaceVariant" />

                                <TextView
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:layout_marginStart="8dp"
                                    android:text="@{profileName != null ? profileName : @string/profile}"
                                    android:textAppearance="@style/TextAppearance.Material3.TitleMedium" />

                                <ImageView
                                    android:layout_width="32dp"
                                    android:layout_height="32dp"
                                    android:background="@drawable/bg_toolbar_button_focus"
                                    android:clickable="true"
                                    android:focusable="true"
                                    android:onClick="@{() -> self.request(Request.ManageProfiles)}"
                                    android:padding="4dp"
                                    android:src="@drawable/ic_mdi_arrange_bring_forward"
                                    android:contentDescription="@string/manage_profiles"
                                    app:tint="?attr/colorOnSurfaceVariant" />
                            </LinearLayout>

                            <!-- Traffic used with MDI icon -->
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="16dp"
                                android:gravity="center_vertical"
                                android:orientation="horizontal"
                                android:visibility="@{hasTrafficInfo ? View.VISIBLE : View.GONE}">

                                <ImageView
                                    android:layout_width="18dp"
                                    android:layout_height="18dp"
                                    android:src="@drawable/ic_mdi_chart_timeline_variant"
                                    app:tint="?attr/colorOnSurfaceVariant" />

                                <TextView
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:layout_marginStart="8dp"
                                    android:text="@string/traffic_used"
                                    android:textAppearance="@style/TextAppearance.Material3.BodyMedium"
                                    android:alpha="0.7" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@{profileTrafficUsed}"
                                    android:textAppearance="@style/TextAppearance.Material3.BodyMedium" />
                            </LinearLayout>

                            <!-- Traffic available with MDI icon -->
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="8dp"
                                android:gravity="center_vertical"
                                android:orientation="horizontal"
                                android:visibility="@{hasTrafficInfo ? View.VISIBLE : View.GONE}">

                                <ImageView
                                    android:layout_width="18dp"
                                    android:layout_height="18dp"
                                    android:src="@drawable/ic_mdi_database_check"
                                    app:tint="?attr/colorOnSurfaceVariant" />

                                <TextView
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:layout_marginStart="8dp"
                                    android:text="@string/traffic_available"
                                    android:textAppearance="@style/TextAppearance.Material3.BodyMedium"
                                    android:alpha="0.7" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@{profileTrafficTotal}"
                                    android:textAppearance="@style/TextAppearance.Material3.BodyMedium" />
                            </LinearLayout>

                            <!-- Expires with MDI icon -->
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="8dp"
                                android:gravity="center_vertical"
                                android:orientation="horizontal"
                                android:visibility="@{hasExpireInfo ? View.VISIBLE : View.GONE}">

                                <ImageView
                                    android:layout_width="18dp"
                                    android:layout_height="18dp"
                                    android:src="@drawable/ic_mdi_calendar_alert"
                                    app:tint="?attr/colorOnSurfaceVariant" />

                                <TextView
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:layout_marginStart="8dp"
                                    android:text="@string/expires"
                                    android:textAppearance="@style/TextAppearance.Material3.BodyMedium"
                                    android:alpha="0.7" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@{profileExpire}"
                                    android:textAppearance="@style/TextAppearance.Material3.BodyMedium" />
                            </LinearLayout>

                            <!-- Updated with MDI icon -->
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="8dp"
                                android:gravity="center_vertical"
                                android:orientation="horizontal">

                                <ImageView
                                    android:layout_width="18dp"
                                    android:layout_height="18dp"
                                    android:src="@drawable/ic_mdi_update"
                                    app:tint="?attr/colorOnSurfaceVariant" />

                                <TextView
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:layout_marginStart="8dp"
                                    android:text="@string/updated"
                                    android:textAppearance="@style/TextAppearance.Material3.BodyMedium"
                                    android:alpha="0.7" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@{profileUpdated}"
                                    android:textAppearance="@style/TextAppearance.Material3.BodyMedium" />
                            </LinearLayout>

                            <!-- Link icons row -->
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="8dp"
                                android:gravity="end|center_vertical"
                                android:orientation="horizontal"
                                android:visibility="@{TextUtils.isEmpty(profileSupportUrl) &amp;&amp; TextUtils.isEmpty(profileWebPageUrl) ? View.GONE : View.VISIBLE}">

                                <ImageView
                                    android:id="@+id/profile_support_icon"
                                    android:layout_width="32dp"
                                    android:layout_height="32dp"
                                    android:background="@drawable/bg_toolbar_button_focus"
                                    android:clickable="true"
                                    android:focusable="true"
                                    android:padding="4dp"
                                    android:src="@drawable/ic_mdi_face_agent"
                                    android:visibility="@{TextUtils.isEmpty(profileSupportUrl) ? View.GONE : View.VISIBLE}"
                                    app:tint="?attr/colorOnSurfaceVariant" />

                                <ImageView
                                    android:id="@+id/profile_webpage_icon"
                                    android:layout_width="32dp"
                                    android:layout_height="32dp"
                                    android:layout_marginStart="4dp"
                                    android:background="@drawable/bg_toolbar_button_focus"
                                    android:clickable="true"
                                    android:focusable="true"
                                    android:padding="4dp"
                                    android:src="@drawable/ic_mdi_home_import_outline"
                                    android:visibility="@{TextUtils.isEmpty(profileWebPageUrl) ? View.GONE : View.VISIBLE}"
                                    app:tint="?attr/colorOnSurfaceVariant" />
                            </LinearLayout>
                            <!-- Announce text for active profile -->
                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="10dp"
                                android:gravity="center"
                                android:textAlignment="center"
                                android:text="@{profileAnnounce}"
                                android:textAppearance="@style/TextAppearance.Material3.BodySmall"
                                android:alpha="0.8"
                                android:visibility="@{TextUtils.isEmpty(profileAnnounce) ? View.GONE : View.VISIBLE}" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <!-- ========== POWER BUTTON (disconnected, has profile) ========== -->
                    <LinearLayout
                        android:id="@+id/power_button_layout"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:layout_marginTop="24dp"
                        android:layout_marginBottom="16dp"
                        android:orientation="vertical"
                        android:visibility="@{hasProfiles &amp;&amp; !clashRunning ? View.VISIBLE : View.GONE}">

                        <FrameLayout
                            android:layout_width="100dp"
                            android:layout_height="100dp"
                            android:background="@drawable/bg_power_button"
                            android:clickable="true"
                            android:focusable="true"
                            android:foreground="@drawable/bg_power_button_ripple"
                            android:onClick="@{() -> self.request(Request.ToggleStatus)}">

                            <ImageView
                                android:layout_width="40dp"
                                android:layout_height="40dp"
                                android:layout_gravity="center"
                                android:src="@drawable/ic_mdi_power"
                                android:contentDescription="@string/tap_to_start"
                                app:tint="@android:color/white" />
                        </FrameLayout>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:text="@string/tap_to_start"
                            android:alpha="0.7"
                            android:textAppearance="@style/TextAppearance.Material3.BodyMedium" />
                    </LinearLayout>

                    <!-- ========== CONNECTED STATE: Proxy groups (accordion) ========== -->
                    <LinearLayout
                        android:id="@+id/proxy_groups_container"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:orientation="vertical"
                        android:visibility="@{clashRunning ? View.VISIBLE : View.GONE}" />

                    <!-- Spacer so content doesn't hide behind FAB -->
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="72dp"
                        android:visibility="@{clashRunning ? View.VISIBLE : View.GONE}" />

                </LinearLayout>
            </ScrollView>

            <!-- ========== BOTTOM NAVIGATION BAR ========== -->
            <com.google.android.material.bottomnavigation.BottomNavigationView
                android:id="@+id/bottom_nav"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingBottom="@{self.surface.insets.bottom}"
                app:menu="@menu/bottom_nav_menu"
                app:labelVisibilityMode="labeled" />

        </LinearLayout>

        <!-- ========== DISCONNECT FAB (connected state, above bottom nav, right-aligned) ========== -->
        <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton
            android:id="@+id/disconnect_fab"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|end"
            android:layout_marginEnd="16dp"
            android:layout_marginBottom="72dp"
            android:onClick="@{() -> self.request(Request.ToggleStatus)}"
            android:text="@string/disconnect"
            android:visibility="@{clashRunning ? View.VISIBLE : View.GONE}"
            app:icon="@drawable/ic_mdi_power" />

    </androidx.coordinatorlayout.widget.CoordinatorLayout>
</layout>
