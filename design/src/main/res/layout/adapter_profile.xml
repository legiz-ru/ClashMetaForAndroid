<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <data>
        <variable
            name="profile"
            type="com.github.kr328.clash.service.model.Profile" />
        <variable
            name="currentTime"
            type="com.github.kr328.clash.design.ui.ObservableCurrentTime" />
        <variable
            name="clicked"
            type="android.view.View.OnClickListener" />
        <variable
            name="menu"
            type="android.view.View.OnClickListener" />
        <variable
            name="editAction"
            type="android.view.View.OnClickListener" />
        <variable
            name="deleteAction"
            type="android.view.View.OnClickListener" />
        <variable
            name="updateAction"
            type="android.view.View.OnClickListener" />
        <variable
            name="announceAction"
            type="android.view.View.OnClickListener" />
        <variable
            name="supportAction"
            type="android.view.View.OnClickListener" />
        <variable
            name="webPageAction"
            type="android.view.View.OnClickListener" />
        <import type="android.view.View" />
        <import type="com.github.kr328.clash.design.util.I18nKt" />
        <import type="com.github.kr328.clash.design.util.IntervalKt" />
        <import type="com.github.kr328.clash.service.model.Profile" />
    </data>

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/root_view"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginVertical="6dp"
        android:clickable="true"
        android:focusable="true"
        android:foreground="@drawable/bg_card_focus_ripple"
        android:onClick="@{clicked}"
        app:cardBackgroundColor="?attr/colorSurfaceVariant"
        app:cardCornerRadius="16dp"
        app:cardElevation="0dp"
        app:strokeColor="@color/card_stroke_focus"
        app:strokeWidth="2dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Profile header: sync + name -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:background="@drawable/bg_toolbar_button_focus"
                    android:clickable="true"
                    android:focusable="true"
                    android:onClick="@{updateAction}"
                    android:src="@drawable/ic_baseline_sync"
                    android:contentDescription="@string/update"
                    android:visibility="@{profile.imported &amp;&amp; profile.type != Profile.Type.File ? View.VISIBLE : View.GONE}"
                    app:tint="?attr/colorOnSurfaceVariant" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp"
                    android:text="@{profile.name}"
                    android:textAppearance="@style/TextAppearance.Material3.TitleMedium" />
            </LinearLayout>

            <!-- Traffic used row with MDI icon -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:visibility="@{profile.download &lt; 2 ? View.GONE : View.VISIBLE}">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:src="@drawable/ic_mdi_chart_timeline_variant"
                    app:tint="?attr/colorOnSurfaceVariant" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp"
                    android:text="@string/traffic_used"
                    android:textAppearance="@style/TextAppearance.Material3.BodyMedium"
                    android:alpha="0.7" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@{I18nKt.toBytesString(profile.download + profile.upload)}"
                    android:textAppearance="@style/TextAppearance.Material3.BodyMedium" />
            </LinearLayout>

            <!-- Traffic available row with MDI icon -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:visibility="@{profile.total &lt; 2 ? View.GONE : View.VISIBLE}">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:src="@drawable/ic_mdi_database_check"
                    app:tint="?attr/colorOnSurfaceVariant" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp"
                    android:text="@string/traffic_available"
                    android:textAppearance="@style/TextAppearance.Material3.BodyMedium"
                    android:alpha="0.7" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@{I18nKt.toBytesString(profile.total)}"
                    android:textAppearance="@style/TextAppearance.Material3.BodyMedium" />
            </LinearLayout>

            <!-- Expires row with MDI icon -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:visibility="@{profile.expire == 0 ? View.GONE : View.VISIBLE}">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:src="@drawable/ic_mdi_calendar_alert"
                    app:tint="?attr/colorOnSurfaceVariant" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp"
                    android:text="@string/expires"
                    android:textAppearance="@style/TextAppearance.Material3.BodyMedium"
                    android:alpha="0.7" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@{I18nKt.toDateStr(profile.expire)}"
                    android:textAppearance="@style/TextAppearance.Material3.BodyMedium" />
            </LinearLayout>

            <!-- Updated row with MDI icon -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:src="@drawable/ic_mdi_update"
                    app:tint="?attr/colorOnSurfaceVariant" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp"
                    android:text="@string/updated"
                    android:textAppearance="@style/TextAppearance.Material3.BodyMedium"
                    android:alpha="0.7" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@{IntervalKt.elapsedIntervalString(currentTime.value - profile.updatedAt, context)}"
                    android:textAppearance="@style/TextAppearance.Material3.BodyMedium" />
            </LinearLayout>

            <!-- Bottom row: checkmark left, link icons + edit/delete right -->
            <LinearLayout
                android:id="@+id/action_buttons_row"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <!-- Active checkmark bottom-left -->
                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_baseline_check"
                    android:visibility="@{profile.active ? View.VISIBLE : View.INVISIBLE}"
                    app:tint="?attr/colorPrimary" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_weight="1" />

                <!-- Announce icon -->
                <ImageView
                    android:id="@+id/announce_button"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:background="@drawable/bg_toolbar_button_focus"
                    android:clickable="true"
                    android:focusable="true"
                    android:onClick="@{announceAction}"
                    android:padding="4dp"
                    android:src="@drawable/ic_mdi_bullhorn_variant_outline"
                    android:visibility="@{profile.announce.length() > 0 ? View.VISIBLE : View.GONE}"
                    app:tint="?attr/colorOnSurfaceVariant" />

                <!-- Support URL icon -->
                <ImageView
                    android:id="@+id/support_button"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_marginStart="4dp"
                    android:background="@drawable/bg_toolbar_button_focus"
                    android:clickable="true"
                    android:focusable="true"
                    android:onClick="@{supportAction}"
                    android:padding="4dp"
                    android:src="@drawable/ic_mdi_face_agent"
                    android:visibility="@{profile.supportUrl.length() > 0 ? View.VISIBLE : View.GONE}"
                    app:tint="?attr/colorOnSurfaceVariant" />

                <!-- Web page URL icon -->
                <ImageView
                    android:id="@+id/webpage_button"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_marginStart="4dp"
                    android:background="@drawable/bg_toolbar_button_focus"
                    android:clickable="true"
                    android:focusable="true"
                    android:onClick="@{webPageAction}"
                    android:padding="4dp"
                    android:src="@drawable/ic_mdi_home_import_outline"
                    android:visibility="@{profile.profileWebPageUrl.length() > 0 ? View.VISIBLE : View.GONE}"
                    app:tint="?attr/colorOnSurfaceVariant" />

                <!-- Edit icon -->
                <ImageView
                    android:id="@+id/edit_button"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_marginStart="4dp"
                    android:background="@drawable/bg_toolbar_button_focus"
                    android:clickable="true"
                    android:focusable="true"
                    android:onClick="@{editAction}"
                    android:padding="4dp"
                    android:src="@drawable/ic_baseline_edit"
                    android:contentDescription="@string/edit"
                    app:tint="?attr/colorOnSurfaceVariant" />

                <!-- Delete icon -->
                <ImageView
                    android:id="@+id/menu_view"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_marginStart="4dp"
                    android:background="@drawable/bg_toolbar_button_focus"
                    android:clickable="true"
                    android:focusable="true"
                    android:onClick="@{deleteAction}"
                    android:padding="4dp"
                    android:src="@drawable/ic_baseline_delete"
                    android:contentDescription="@string/delete"
                    app:tint="?attr/colorOnSurfaceVariant" />
            </LinearLayout>

        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
</layout>
