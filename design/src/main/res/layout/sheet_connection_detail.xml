<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        android:paddingTop="12dp"
        android:paddingBottom="16dp">

        <!-- Header: host + status badge -->
        <TextView
            android:id="@+id/detail_header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAppearance="@style/TextAppearance.Material3.TitleSmall"
            android:layout_marginBottom="12dp" />

        <!-- TRAFFIC -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/conn_detail_traffic"
            android:textAppearance="@style/TextAppearance.Material3.LabelSmall"
            android:textColor="?attr/colorPrimary"
            android:layout_marginBottom="2dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="10dp">

            <include layout="@layout/item_conn_detail_row"
                android:id="@+id/row_upload_speed" />
            <include layout="@layout/item_conn_detail_row"
                android:id="@+id/row_download_speed" />
            <include layout="@layout/item_conn_detail_row"
                android:id="@+id/row_upload" />
            <include layout="@layout/item_conn_detail_row"
                android:id="@+id/row_download" />
            <include layout="@layout/item_conn_detail_row"
                android:id="@+id/row_duration" />

        </LinearLayout>

        <!-- ROUTING -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/conn_detail_routing"
            android:textAppearance="@style/TextAppearance.Material3.LabelSmall"
            android:textColor="?attr/colorPrimary"
            android:layout_marginBottom="2dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="10dp">

            <include layout="@layout/item_conn_detail_row"
                android:id="@+id/row_rule" />
            <include layout="@layout/item_conn_detail_row"
                android:id="@+id/row_chain" />
            <include layout="@layout/item_conn_detail_row"
                android:id="@+id/row_type" />

        </LinearLayout>

        <!-- NETWORK -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/conn_detail_network"
            android:textAppearance="@style/TextAppearance.Material3.LabelSmall"
            android:textColor="?attr/colorPrimary"
            android:layout_marginBottom="2dp" />

        <LinearLayout
            android:id="@+id/section_network"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="10dp">

            <include layout="@layout/item_conn_detail_row"
                android:id="@+id/row_host" />
            <include layout="@layout/item_conn_detail_row"
                android:id="@+id/row_sniff_host" />
            <include layout="@layout/item_conn_detail_row"
                android:id="@+id/row_dest_ip" />
            <include layout="@layout/item_conn_detail_row"
                android:id="@+id/row_dest_geoip" />
            <include layout="@layout/item_conn_detail_row"
                android:id="@+id/row_dest_asn" />
            <include layout="@layout/item_conn_detail_row"
                android:id="@+id/row_src_ip" />
            <include layout="@layout/item_conn_detail_row"
                android:id="@+id/row_src_geoip" />
            <include layout="@layout/item_conn_detail_row"
                android:id="@+id/row_src_asn" />
            <include layout="@layout/item_conn_detail_row"
                android:id="@+id/row_src_port" />
            <include layout="@layout/item_conn_detail_row"
                android:id="@+id/row_dest_port" />
            <include layout="@layout/item_conn_detail_row"
                android:id="@+id/row_remote_dest" />

        </LinearLayout>

        <!-- PROCESS -->
        <LinearLayout
            android:id="@+id/section_process"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="10dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/conn_detail_process"
                android:textAppearance="@style/TextAppearance.Material3.LabelSmall"
                android:textColor="?attr/colorPrimary"
                android:layout_marginBottom="2dp" />

            <include layout="@layout/item_conn_detail_row"
                android:id="@+id/row_process" />
            <include layout="@layout/item_conn_detail_row"
                android:id="@+id/row_process_path" />

        </LinearLayout>

        <!-- INBOUND -->
        <LinearLayout
            android:id="@+id/section_inbound"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="10dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/conn_detail_inbound"
                android:textAppearance="@style/TextAppearance.Material3.LabelSmall"
                android:textColor="?attr/colorPrimary"
                android:layout_marginBottom="2dp" />

            <include layout="@layout/item_conn_detail_row"
                android:id="@+id/row_inbound_ip" />
            <include layout="@layout/item_conn_detail_row"
                android:id="@+id/row_inbound_port" />
            <include layout="@layout/item_conn_detail_row"
                android:id="@+id/row_inbound_name" />
            <include layout="@layout/item_conn_detail_row"
                android:id="@+id/row_inbound_user" />

        </LinearLayout>

        <!-- OTHER -->
        <LinearLayout
            android:id="@+id/section_other"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/conn_detail_other"
                android:textAppearance="@style/TextAppearance.Material3.LabelSmall"
                android:textColor="?attr/colorPrimary"
                android:layout_marginBottom="2dp" />

            <include layout="@layout/item_conn_detail_row"
                android:id="@+id/row_dns_mode" />
            <include layout="@layout/item_conn_detail_row"
                android:id="@+id/row_special_proxy" />
            <include layout="@layout/item_conn_detail_row"
                android:id="@+id/row_special_rules" />
            <include layout="@layout/item_conn_detail_row"
                android:id="@+id/row_dscp" />

        </LinearLayout>

    </LinearLayout>
</ScrollView>
